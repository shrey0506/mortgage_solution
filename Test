# Recursive function for hierarchical pos
def hierarchy_pos(G, root=None, width=1., vert_gap=0.3, vert_loc=0, xcenter=0.5):
    pos = {}
    def _hierarchy_pos(G, node, left, right, vert_loc, pos, parent=None):
        children = list(G.neighbors(node))
        if not children:
            pos[node] = ((left+right)/2, vert_loc)
        else:
            dx = (right-left)/len(children)
            nextx = left
            pos[node] = ((left+right)/2, vert_loc)
            for child in children:
                pos = _hierarchy_pos(G, child, nextx, nextx+dx, vert_loc-vert_gap, pos, node)
                nextx += dx
        return pos
    if root is None:
        root = [n for n,d in G.in_degree() if d==0][0]  # pick a root (no parent)
    return _hierarchy_pos(G, root, 0, width, vert_loc, pos)

# Get positions
